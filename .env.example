# =====================================================================
# DeepSeek-SaaS-Starter 环境变量模板
#
# 使用方法：复制本文件为 .env 并填入真实值
#   cp .env.example .env
#
# ⚠️ 安全提醒：.env 已被 .gitignore 忽略，切勿把真实密钥提交到版本库。
#   本文件中所有变量的值都刻意留空，请勿直接把示例值写死回代码。
# =====================================================================

# ---------------- 应用服务 ----------------
# 运行环境：development / production / test
NODE_ENV=

# HTTP 服务监听端口（Docker 端口映射与容器 EXPOSE 均引用此值）
PORT=

# 反向代理：部署在 Docker/nginx 后面时设为 true，才能正确解析客户端真实 IP
# （影响限流对 IP 的识别，务必按实际部署情况配置）
TRUST_PROXY=

# ---------------- MongoDB Atlas ----------------
# Atlas 连接串，格式：mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
# 获取位置：Atlas 控制台 → Database → Connect → Drivers
# 建议在串末尾携带 retryWrites=true&w=majority 参数
MONGODB_URI=

# 使用的数据库名（无需手动创建，首次写入时自动创建）
MONGODB_DB_NAME=

# 建立 TCP 连接的超时时间（毫秒）
MONGODB_CONNECT_TIMEOUT_MS=

# 选择可用节点（server selection）的超时时间（毫秒）
MONGODB_SERVER_SELECTION_TIMEOUT_MS=

# 单次操作 socket 空闲超时（毫秒），必须大于 server selection 超时
MONGODB_SOCKET_TIMEOUT_MS=

# 连接池最大并发连接数
MONGODB_MAX_POOL_SIZE=

# 初始连接失败时的最大重试次数
MONGODB_MAX_RETRIES=

# 重试基础间隔（毫秒），实际等待 = 基础间隔 × 当前第几次重试（指数退避）
MONGODB_RETRY_DELAY_MS=

# 请求日志保留天数（日志自动过期，控制 Atlas 存储成本，默认 30）
REQUEST_LOG_TTL_DAYS=

# ---------------- DeepSeek API ----------------
# 服务端调用 DeepSeek 的密钥（只存在于服务端，绝不暴露给前端）
# 获取位置：https://platform.deepseek.com → API Keys
DEEPSEEK_API_KEY=

# 服务端地址（默认 https://api.deepseek.com，末尾无需斜杠、无需带路径）
DEEPSEEK_API_BASE_URL=

# 模型名（默认 deepseek-v4-flash；可选 deepseek-v4-pro）
# ⚠️ 旧别名 deepseek-chat / deepseek-reasoner 已于 2026-07-24 弃用，请勿再使用
DEEPSEEK_MODEL=

# 思考模式：disabled（普通）/ enabled（深度思考）；留空则使用模型默认
DEEPSEEK_THINKING_TYPE=

# 单次请求整体超时（毫秒，默认 60000）
DEEPSEEK_TIMEOUT_MS=

# 建立连接超时（毫秒，默认 15000）
DEEPSEEK_CONNECT_TIMEOUT_MS=

# 服务端强制限制的最大输出 token 数（默认 4096，防止恶意请求烧钱）
DEEPSEEK_MAX_TOKENS=

# 默认采样温度（0~2，默认 0.7）
DEEPSEEK_TEMPERATURE=

# 单次请求允许的最大消息条数 / 总字符数（输入侧防刷限制）
MAX_INPUT_MESSAGES=
MAX_INPUT_CHARS=

# ---------------- 限流（防刷，核心卖点）----------------
# 同一 IP 每分钟最大请求数（默认 5）
RATE_LIMIT_MINUTE_MAX=

# 同一 IP 每天最大请求数（默认 100）
RATE_LIMIT_DAY_MAX=

# 登录/注册接口的限流：同一 IP 每小时最大尝试次数（默认 20，防暴力破解）
RATE_LIMIT_AUTH_MAX=

# 限流依赖 MongoDB；当库异常时是否放行：
#   true  = 放行（优先可用性，但暂时失去防护）
#   false = 拦截（优先安全，宁可误伤也不放过）
RATE_LIMIT_FAIL_OPEN=

# ---------------- 认证（JWT）----------------
# 用于签发 / 校验 JWT 的密钥，生产环境务必使用足够长的随机字符串
# 生成示例：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Token 有效期，示例：7d / 12h / 60m / 3600s
JWT_EXPIRES_IN=

# ---------------- CORS ----------------
# 允许的跨域来源，多个用逗号分隔；* 表示允许所有（生产环境建议收敛为具体域名）
CORS_ORIGIN=

# ---------------- Stripe 支付（预留）----------------
# TODO: 如需对接 Stripe 支付，请填写以下两项，
#       并取消 src/services/billing.service.js 中相关注释。
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------- 多租户（预留）----------------
# 多租户解析使用的请求头名称（例如 x-tenant-id）
TENANT_HEADER_NAME=

# ---------------- 日志 ----------------
# 日志级别：trace / debug / info / warn / error / fatal
LOG_LEVEL=
